
# Application
APP_NAME="Sapio AI Backend"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# PostgreSQL (Phase 3)
DATABASE_URL=postgresql+psycopg://sapio_user:123xc789xc@localhost:5432/sapio_db

# Authentication (Phase 4)
JWT_SECRET_KEY=a1825c960309908976e3cb265811d64318004fbcb747752ce8fe627f2b188926
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Document uploads
STORAGE_ROOT=storage/uploads
MAX_UPLOAD_SIZE_MB=20

# Text extraction
MAX_EXTRACTED_CHARACTERS=3000000
MAX_PDF_PAGES=1000
MAX_EPUB_UNCOMPRESSED_MB=50

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CHUNK_SIZE=12000
GEMINI_MAX_CHUNKS=60
GEMINI_MAX_OUTPUT_TOKENS=16000


# Phase 11 - Audio
AUDIO_STORAGE_ROOT=storage/audio
PIPER_MODELS_DIR=models/piper
PIPER_MAX_CHARS=900
PIPER_MAX_CHUNKS=100
FFMPEG_EXECUTABLE=ffmpeg

